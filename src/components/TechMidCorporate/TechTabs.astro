---
import CorporatesSubTabs from "@/components/BorrowVCL/CorporatesSubTabs.astro";
import FinancialSubTabs from "@/components/BorrowVCL/FinancialSubTabs.astro";
import CreadIQAbout from "./credIQaboutDetails.astro";
import ArtemisaboutDetails from "./artemisaboutDetails.astro";
import MidcorpCrediq from "./midcorporateCrediq.astro";
import ArtemisKeyFeature from "./artemisKeyFeature.astro";
import CredIQKeyFeature from "./credIQKeyFeature.astro";
import ArtemisValueDelivered from "./artemisValueDelivered.astro"
import CreadIQValueDelivered from "./credIQValueDelivered.astro"
import ArtemisSlider from './artemisSlider.astro';
import CredIQSlider from './credIQSlider.astro';

---

<div class="w-full mx-auto relative">
  <!-- Tab Buttons -->
  <div class="container mx-auto px-4 lg:px-8 xl:px-4">
    <div class="flex justify-start">
      <div
        class="flex space-x-2 w-full md:max-w-fit relative items-start z-2  mb-4 md:mb-0 min-h-[140px]"
      >
        <button
          class="borrowvcl-btn px-8 border-1 border-dashed border-[#F58220] font-normal transition-colors duration-300 w-1/2 md:min-w-[350px] text-left"
          data-tab="corporates"
          aria-selected="true"
        >
        <h4 class="text-[28px] md:text-[35px] font-normal mb-3 font-heading">01.</h4>
          <p class="text-[16px] md:text-[18px] font-normal uppercase">Credlyst</p>
        </button>
        <button
          class="borrowvcl-btn px-8 md:px-12 border-1 border-dashed border-[#F58220] transition-colors duration-300 w-1/2 md:min-w-[350px] text-left"
          data-tab="financial"
          aria-selected="false"
        >
         <h4 class="text-[28px] md:text-[35px] font-normal mb-3 font-heading">02.</h4>
          <p class="text-[16px] md:text-[18px] font-normal uppercase">Artemis</p>
        </button>
      </div>
    </div>
  </div>

  <!-- Tab Panels -->
  <div class="relative mt-0">
    <!-- First tab visible -->
    <div
      id="corporates"
      class="borrowvcl-panel inset-0 transition-all duration-500 ease-out transform opacity-100 translate-y-0"
    >
      <section class="md:pt-6">
       <CreadIQAbout/>
      <CredIQSlider/>
       <CredIQKeyFeature/>
       <CreadIQValueDelivered/>
      </section>
    </div>

    <!-- Second tab hidden by default -->
    <div
      id="financial"
      class="borrowvcl-panel inset-0 transition-all duration-500 ease-out transform opacity-0 -translate-y-2 hidden"
    >
      <section class="pb-0 md:pt-6">
        <ArtemisaboutDetails/>
        <ArtemisSlider/>
       <ArtemisKeyFeature/>
       <ArtemisValueDelivered/>
      </section>
    </div>
  </div>
</div>
<link rel="stylesheet" href="/styles/techcommon/techtabs.css" />
<script type="module" src="/scripts/techcorporate/techtabs.js"></script>