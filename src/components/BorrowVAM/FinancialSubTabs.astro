---
import LogoShape from "../../../public/logowhite.svg";
import LogoAnimation from "../../components/common/logoglow2.astro";
const { items,title,description  } = Astro.props;

---

<div class="w-full  md:py-[70px] py-[40px]">
  <div class="container mx-auto px-4 xl:px-4 lg:px-8">

    <!-- Heading -->
    <div class="flex flex-col md:flex-row justify-between md:gap-10">
      <h2 class="text-[28px] md:text-[35px] font-heading leading-[120%] mb-4 gradient-text w-full md:w-5/12">
      {title}
      </h2>
      <p class="font-normal text-[17px] w-full md:w-8/12 max-w-[674px]">
     {description}

      </p>
    </div>

    <!-- MOBILE ACCORDION -->
    <div class="md:hidden mt-6 space-y-4">

      <!-- Accordion Item 1 -->
      {items.map((item, index) => (
      <!-- Accordion Item 1 -->
      <div class="accordion rounded">
        <button class="acc-btn w-full py-4 px-4 flex justify-between items-center text-[#F58220] font-medium text-[16px]">
         {item.title}
          <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="10" viewBox="0 0 16 10" fill="none">
              <path d="M0.707 0.707L7.707 7.707L14.707 0.707" stroke="#666" stroke-width="2"/>
            </svg>
          </span>
        </button>
        <div class="acc-content p-5 bg-[#F8F8F8]">
          <p class="mb-4" set:html={item.description}></p>
          <p><strong>Tenor:</strong> {item.tenor}</p>
        </div>
      </div>
 ))}
     

   

    </div>

    <!-- DESKTOP TABS -->
    <div class="hidden md:flex flex-col md:flex-row w-full items-start justify-between mt-10 gap-5">
      <div class="flex md:w-2/4 items-start pl-7">
        <div class="relative -left-[13px] min-w-[240px] flex flex-col gap-y-2">
          {items.map((item, index) => (
    <button
      class={`corporatetab-btn py-2 px-7 text-left text-[14px]  text-[#F58220] font-medium uppercase ${
        index === 0 ? "active-tab" : ""
      }`}
    >
      {item.title}
    </button>
  ))}
        </div>
        <div class="w-full md:flex justify-start hidden ">
          <LogoAnimation />
        </div>
      </div>

      <div class="w-full flex-1 lg:max-w-[674px] lg:min-w-[674px]">
        <!-- Tab Content 1 -->
        {items.map((item, index) => (
    <div
      class={`corporatetab-content bg-[#F8F8F8] p-10 border border-dashed border-[#F58220] ${
        index === 0 ? "opacity-100 translate-y-0" : "opacity-0 -translate-y-4 hidden"
      }`}
    >
      <h2 class="font-semibold mb-6">{item.title}</h2>
      <p class="mb-8">{item.description}</p>
      <p>
        <span class="uppercase">Tenor:</span>
        <strong class="pl-12">{item.tenor}</strong>
      </p>
    </div>
  ))}
       

        

      </div>
    </div>

  </div>
<link rel="stylesheet" href="/styles/borrowvam/financialsubtabs.css" />
<script type="module" src="/scripts/borrowvam/finsubtabs.js"></script>
