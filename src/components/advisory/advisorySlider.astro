---
import LogoShape from '../../../public/Vivrithi_logo.svg';
import AdviorySlider from '@/components/common/AdviorySlider';


const { slides = [] } = Astro.props;
---

<div class="w-full xl:px-0 md:px-[0px] md:pt-[0px] pt-[40px] px-[0px] target-section">
  
    <div class="container mx-auto px-0 px-4 xl:px-4 lg:px-8">
      <div class="border border-dashed border-[#F58220] mb-34 md:mb-30 border-b-0"> 
 {slides.length > 0 ? (
        <AdviorySlider
          slides={slides}
          client:only="react"
        />
      ) : (
        <div class="py-12 text-center text-gray-500">
          <p>No advisory content available at the moment.</p>
        </div>
      )}
  </div>
  </div>
  </div>