---
import LogoShape from '../../../public/Vivrithi_logo.svg';
---

<div class="bg-white w-full xl:px-0 md:px-[40px] md:pt-[70px] pt-[30px] px-[20px]">
  <div class="container mx-auto">
    <div class="flex flex-col lg:flex-row flex-wrap">
      <div class="w-full lg:w-5/24 md:pr-10">
        <!-- Column 1 content -->
        <div class="px-0 pb-4 md:pb-0">
          <div data-reveal class="fade-up pt-[25px] flex justify-start flex-col items-start">
            <h2 class="text-[28px] md:text-[35px] md:text-4xl font-heading leading-[120%] mb-4 gradient-text">
              Why VCL?
            </h2>
            <p class="max-w-3xl pt-0 pb-10 lg:pb-0 lg:pt-[20px] leading-[24px] text-[#1B1B1B]">
              We go beyond conventional lending; we combine industry knowledge, technology-driven execution, and a human approach to business.
            </p>
          </div>
        </div>
      </div>

      <div class="w-full flex lg:w-19/24 px-2 lg:min-h-[440px]">
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 w-full banner_sub_grid">
          
          <!-- Card 1 -->
          <li class="group [perspective:1000px] border-l-0 lg:border-l-1 border-dashed border-[#F58220]">
            <div class="flip-inner relative transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)]">
              
              <!-- Front -->
              <div class="absolute inset-0 flex flex-col items-start justify-between lg:justify-start rounded-xl text-xl font-semibold [backface-visibility:hidden] p-4 flip-front">
                <h3 class="text-[#6D6D6D] text-[18px] md:text-[21px]">Flexible financing across growth cycles</h3>
                <a data-reveal class="responsive-arrow_btn fade-up contact_cta px-[14px] py-[12px] flex items-center gap-2 text-white uppercase hover:text-blue-600 transition my-4">
                        <span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="15" viewBox="0 0 11 15" fill="none">
                          <path d="M1 13.5001L9 7.00006L1 1.00006" stroke="white" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        </span>
                      </a>
              </div>

              <!-- Back -->
              <div class="absolute inset-0 flex flex-col items-start justify-start text-white [transform:rotateY(180deg)] [backface-visibility:hidden] banner_sub_grid_item_bg">
                <img src={LogoShape.src} alt="Vivrithi" class="w-[50px] h-auto" />
                <h3 class="text-lg uppercase text-[17px] font-semibold mt-4">Flexible financing across growth cycles</h3>
                <div class="mt-2 mb-5 desc text-sm md:text-lg">
                  From working capital gaps to expansion projects, our product suite covers diverse requirements — helping businesses access capital when they need it most.
                </div>
              </div>

            </div>
          </li>

          <!-- Card 2 -->
          <li class="group [perspective:1000px] card-2-border-l">
            <div class="flip-inner relative transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)]">
              <div class="absolute inset-0 flex flex-col items-start justify-between lg:justify-start rounded-xl text-xl font-semibold [backface-visibility:hidden] p-4 flip-front">
                <h3 class="text-[#6D6D6D] text-[18px] md:text-[21px]">Tech-driven, fast, and transparent</h3>
                <a data-reveal class="responsive-arrow_btn fade-up contact_cta px-[14px] py-[12px] flex items-center gap-2 text-white uppercase hover:text-blue-600 transition my-4">
                        <span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="15" viewBox="0 0 11 15" fill="none">
                          <path d="M1 13.5001L9 7.00006L1 1.00006" stroke="white" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        </span>
                      </a>
              </div>
              <div class="absolute inset-0 flex flex-col items-start justify-start text-white [transform:rotateY(180deg)] [backface-visibility:hidden] banner_sub_grid_item_bg">
                <img src={LogoShape.src} alt="Vivrithi" class="w-[50px] h-auto" />
                <h3 class="text-lg uppercase text-[17px] font-semibold mt-4">Tech-driven, fast, and transparent</h3>
                <div class="mt-2 mb-5 desc text-sm md:text-lg">
                  Our proprietary platforms reduce processing times and make financing seamless. We enable quick turnarounds without compromising on due diligence or governance.
                </div>
              </div>
            </div>
          </li>

          <!-- Card 3 -->
          <li class="group [perspective:1000px] card-3-border-b">
            <div class="flip-inner relative transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)]">
              <div class="absolute inset-0 flex flex-col items-start justify-between lg:justify-start rounded-xl text-xl font-semibold [backface-visibility:hidden] p-4 flip-front">
                <h3 class="text-[#6D6D6D] text-[18px] md:text-[21px]">Tailored solutions, right-sized for your goals</h3>
                <a data-reveal class="responsive-arrow_btn fade-up contact_cta px-[14px] py-[12px] flex items-center gap-2 text-white uppercase hover:text-blue-600 transition my-4">
                        <span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="15" viewBox="0 0 11 15" fill="none">
                          <path d="M1 13.5001L9 7.00006L1 1.00006" stroke="white" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        </span>
                      </a>
              </div>
              <div class="absolute inset-0 flex flex-col items-start justify-start text-white [transform:rotateY(180deg)] [backface-visibility:hidden] banner_sub_grid_item_bg">
                <img src={LogoShape.src} alt="Vivrithi" class="w-[50px] h-auto" />
                <h3 class="text-lg uppercase text-[17px] font-semibold mt-4">Tailored solutions, right-sized for your goals</h3>
                <div class="mt-2 mb-5 desc text-sm md:text-lg">
                  We offer customizable structures that fit your business model, repayment capacity, and operational requirements — ensuring capital is aligned to growth ambitions.
                </div>
              </div>
            </div>
          </li>

          <!-- Card 4 -->
          <li class="group [perspective:1000px] bottom_no_border">
            <div class="flip-inner relative transition-transform duration-700 [transform-style:preserve-3d] group-hover:[transform:rotateY(180deg)]">
              <div class="absolute inset-0 flex flex-col items-start justify-between lg:justify-start rounded-xl text-xl font-semibold [backface-visibility:hidden] p-4 flip-front">
                <h3 class="text-[#6D6D6D] text-[18px] md:text-[21px]">Deep understanding of mid-market dynamics</h3>
                <a data-reveal class="responsive-arrow_btn fade-up contact_cta px-[14px] py-[12px] flex items-center gap-2 text-white uppercase hover:text-blue-600 transition my-4">
                        <span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="15" viewBox="0 0 11 15" fill="none">
                          <path d="M1 13.5001L9 7.00006L1 1.00006" stroke="white" stroke-width="2" stroke-linecap="round"/>
                          </svg>
                        </span>
                      </a>
              </div>
              <div class="absolute inset-0 flex flex-col items-start justify-start text-white [transform:rotateY(180deg)] [backface-visibility:hidden] banner_sub_grid_item_bg">
                <img src={LogoShape.src} alt="Vivrithi" class="w-[50px] h-auto" />
                <h3 class="text-lg uppercase text-[17px] font-semibold mt-4">Deep understanding of mid-market dynamics</h3>
                <div class="mt-2 mb-5 desc text-sm md:text-lg">
                  With sector expertise and an in-depth understanding of how businesses operate, we structure solutions that are practical, sustainable, and risk-managed.
                </div>
              </div>
            </div>
          </li>

        </ul>
      </div>
    </div>
  </div>
</div>

<style>
/* Container spacing */
.banner_sub_grid li {
  border-left: dashed 1px #F58220; /* changed from border-right */
  border-right: dashed 1px #F58220;
  padding: 10px; /* spacing left/right */
  transition: 0.3s ease-in all;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: auto;
  max-height: 250px; /* default max height for border */
  position: relative;
}

/* No border adjustments */
.bottom_no_border {
  border-bottom: none !important;
}
.left_no_border {
  border-left: none !important; /* changed from right */
}

/* Flip back background */
.banner_sub_grid_item_bg {
  background: linear-gradient(32deg, rgba(59, 186, 226, 1) 0%, rgba(0, 1, 138, 1) 100%);
  padding-top: 60px; /* space for logo */
  padding-left: 20px;
  padding-right: 20px;
  position: relative;
  overflow: visible;
  top:-30px;
  min-height: 470px;
}

/* Logo position */
.banner_sub_grid_item_bg img {
  position: absolute;
  top: 15px;
  left: 15px;
  max-width: 50px;
  max-height: 50px;
  object-fit: contain;
  z-index: 2;
}

/* Front card padding */
.flip-front h3 {
  margin-top: 0;
}

/* Description */
.banner_sub_grid_item_bg .desc {
  margin-top: 10px;
  height: auto;
  overflow: visible;
}

/* Auto-flip */
.auto-flipped {
  transform: rotateY(180deg) !important;
}
.responsive-arrow_btn{
  display: none;
}
/* Responsive adjustments */
@media only screen and (max-width: 1024px) {
  .banner_sub_grid li {
    min-height: 360px;
    border-bottom: dashed 1px #F58220;
    border-left: none;
  }
  .responsive-arrow_btn{
   display: block;
  }
  .banner_sub_grid_item_bg {
    top:0px;
  }
}
@media only screen and (max-width: 767px) {
  .banner_sub_grid li {
    min-height: 320px;
  }
  .banner_sub_grid li.card-3-border-b {
    border-bottom: dashed 1px #F58220;
  }
  .banner_sub_grid_item_bg {
    min-height: auto;
   }
}
</style>
<script type="module" src="/scripts/about/why.js"></script>

